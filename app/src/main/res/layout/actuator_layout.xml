<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp">
    <!--  执行器布局区域  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:paddingRight="4dp">
        <!-- 第一行 设备状态和加湿器控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingRight="4dp"
            android:layout_marginBottom="15dp">
            <!-- 设备状态 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/device_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#CAC4D0"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="10dp"
                    android:paddingRight="5dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/device_icon_style1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_device_offline"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                    <!-- 文本容器（右侧，整体垂直居中） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingRight="5dp"
                        app:layout_constraintStart_toEndOf="@id/device_icon_style1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <!-- "离线"（在上方） -->
                        <TextView
                            android:id="@+id/device_text_Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="离线"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/unbind" />

                        <!-- "设备状态："（在下方） -->
                        <TextView
                            android:id="@+id/device_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备状态"
                            android:textSize="15sp"
                            android:textColor="@color/text_state"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 加湿器控制 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/humidifier_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginHorizontal="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#CAC4D0"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/humidifier_icon_style1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_humidifier_off"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:srcCompat="@drawable/ic_humidifier_off"/>

                    <!-- 添加了最大宽度的约束，避免文本与开关重叠 -->
                    <TextView
                        android:id="@+id/humidifier_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="加湿器"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:layout_constraintStart_toEndOf="@id/humidifier_icon_style1"
                        app:layout_constraintEnd_toStartOf="@id/humidifier_switch"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="加湿器"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/humidifier_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:onClick="toggleHumidifier"
                        android:padding="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/custom_thumb_tint"
                        app:trackTint="@drawable/custom_track_tint" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- 第二行 灯光控制和风扇控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingRight="4dp">
            <!-- 灯光控制卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/led_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#CAC4D0"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/led_icon_style1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_led_off"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:srcCompat="@drawable/ic_led_off"/>

                    <!-- 添加了最大宽度的约束，避免文本与开关重叠 -->
                    <TextView
                        android:id="@+id/led_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="灯光"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:layout_constraintStart_toEndOf="@id/led_icon_style1"
                        app:layout_constraintEnd_toStartOf="@id/led_switch"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="灯光"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/led_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:onClick="toggleLed"
                        android:padding="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/custom_thumb_tint"
                        app:trackTint="@drawable/custom_track_tint" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 风扇控制卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fan_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginHorizontal="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#CAC4D0"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/fan_icon_style1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_fan_off"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:srcCompat="@drawable/ic_fan_off"/>

                    <!-- 添加了最大宽度的约束，避免文本与开关重叠 -->
                    <TextView
                        android:id="@+id/fan_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="风扇"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:layout_constraintStart_toEndOf="@id/fan_icon_style1"
                        app:layout_constraintEnd_toStartOf="@id/fan_switch"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="风扇"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/fan_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:onClick="toggleFan"
                        android:padding="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/custom_thumb_tint"
                        app:trackTint="@drawable/custom_track_tint" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>