<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/para_border_background"
        android:paddingBottom="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="控制参数设置"
            android:textSize="20sp"
            android:textColor="@color/blue_border"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:shadowColor="#21DEF3"
            android:shadowRadius="5"
            android:shadowDx="0"
            android:shadowDy="0"
            android:layout_gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
        <!-- 温度上限设置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <!-- 滑动条容器（添加FrameLayout包裹） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- 滑动条 -->
                <!-- 在进度条内显示"温度上限"文字 -->
                <SeekBar
                    android:id="@+id/tempLimitUpSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:min="25"
                    android:progress="40"
                    android:progressDrawable="@drawable/custom_seekbar_progress"
                    android:progressTint="@color/alert_blue"
                    android:splitTrack="false"
                    android:thumb="@drawable/custom_thumb"
                    android:thumbTint="@color/alert_blue" />

                <TextView
                    android:id="@+id/tempLimitUpValue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="温度上限:40°C"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false"/>
            </FrameLayout>
        </LinearLayout>
        <!-- 温度下限设置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <!-- 滑动条容器（添加FrameLayout包裹） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- 滑动条 -->
                <SeekBar
                    android:id="@+id/humiLimitDownSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:min="40"
                    android:progress="50"
                    android:progressDrawable="@drawable/custom_seekbar_progress"
                    android:progressTint="@color/alert_blue"
                    android:splitTrack="false"
                    android:thumb="@drawable/custom_thumb"
                    android:thumbTint="@color/alert_blue" />

                <TextView
                    android:id="@+id/humiLimitDownValue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="湿度下限:50%"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false"/>
            </FrameLayout>
        </LinearLayout>
        <!-- 参数设置按钮 -->
        <Button
            android:id="@+id/btn_save_set"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:padding="0dp"
            android:text="参数设置"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_background"
            android:stateListAnimator="@animator/button_press_animator"
            />
    </LinearLayout>
</ScrollView>
